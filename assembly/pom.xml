<?xml version="1.0" encoding="UTF-8"?>
<project>
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<relativePath>../pom.xml</relativePath>
		<groupId>ru.bmstu.rk9.rao</groupId>
		<artifactId>parent</artifactId>
		<version>3.9.0</version>
	</parent>

	<artifactId>assembly</artifactId>
	<name>Package binaries</name>
	<packaging>pom</packaging>

	<properties>
		<assembly-descriptor1>lib-jar-without-version.xml</assembly-descriptor1>
		<assembly-descriptor2>jars-only.xml</assembly-descriptor2>
	</properties>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>copy-jars</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<overwrite>true</overwrite>
							<outputDirectory>${basedir}/target/plugins</outputDirectory>
							<resources>
								<resource>
									<directory>${basedir}/../ru.bmstu.rk9.rao/target</directory>
									<includes>
										<include>ru.bmstu.rk9.rao*.jar</include>
									</includes>
								</resource>
								<resource>
									<directory>${basedir}/../ru.bmstu.rk9.rao.lib/target</directory>
									<includes>
										<include>ru.bmstu.rk9.rao.lib*.jar</include>
									</includes>
								</resource>
								<resource>
									<directory>${basedir}/../ru.bmstu.rk9.rao.ui/target</directory>
									<includes>
										<include>ru.bmstu.rk9.rao.ui*.jar</include>
									</includes>
								</resource>
								<resource>
									<directory>${basedir}/../ru.bmstu.rk9.rao.plugins/raox-game5/target</directory>
									<includes>
										<include>ru.bmstu.rk9.raox.plugins.game5*jar</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.7.1</version>
				<configuration>
					<descriptors>
						<descriptor>${assembly-descriptor1}</descriptor>
						<descriptor>${assembly-descriptor2}</descriptor>
					</descriptors>
					<finalName>raox</finalName>
					<attach>false</attach>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
