<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <!-- Do not inherit disappearing HTTP/Codehaus repositories from old POMs. -->
  <mirrors>
    <mirror>
      <id>central</id>
      <url>https://repo1.maven.org/maven2</url>
      <mirrorOf>*</mirrorOf>
      <mirrorOfLayouts>default</mirrorOfLayouts>
    </mirror>
  </mirrors>
  <profiles>
    <profile>
      <id>isolated-build</id>
      <properties>
        <tycho.localArtifacts>ignore</tycho.localArtifacts>
        <tycho.disableP2Mirrors>true</tycho.disableP2Mirrors>
      </properties>
    </profile>
  </profiles>
  <activeProfiles><activeProfile>isolated-build</activeProfile></activeProfiles>
</settings>
