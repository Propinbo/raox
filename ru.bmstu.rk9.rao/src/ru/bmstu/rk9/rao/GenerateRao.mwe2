module ru.bmstu.rk9.rao.GenerateRao

import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var runtimeProject = "../ru.bmstu.rk9.rao"

Workflow {
    component = XtextGenerator {
        configuration = {
            project = StandardProjectConfig {
                baseName = "ru.bmstu.rk9.rao"
                rootPath = "${runtimeProject}/.."
                runtimeTest = { enabled = true }
                genericIde = {
                    name = "ru.bmstu.rk9.rao.ui"
                    root = "${runtimeProject}.ui"
                }
                eclipsePlugin = { enabled = true }
                createEclipseMetaData = false
            }
            code = {
                preferXtendStubs = false
                encoding = "UTF-8"
                lineDelimiter = "\n"
            }
        }
        language = StandardLanguage {
            name = "ru.bmstu.rk9.rao.Rao"
            fileExtensions = "rao"
            serializer = { generateStub = false }
            junitSupport = { generateStub = false }
            validator = { generateXtendStub = true }
            labelProvider = { generateXtendStub = true }
            outline = { generateXtendStub = true }
            quickFixProvider = { generateXtendStub = true }
            contentAssist = { generateXtendStub = true }
            parserGenerator = {
                antlrParam = "-Xconversiontimeout"
                antlrParam = "0"
                options = {
                    classSplitting = true
                    fieldsPerClass = "500"
                    methodsPerClass = "500"
                }
            }
        }
    }
}
